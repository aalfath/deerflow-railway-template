# Adapted from upstream docker/nginx/nginx.conf (v2.2.0) for Railway:
# listens on $PORT, finds the services over Railway's private network, drops the
# Kubernetes provisioner route, and serves /healthz for Railway's health check.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    sendfile on;
    tcp_nodelay on;
    keepalive_timeout 65;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json application/xml image/svg+xml;
    access_log off;
    resolver ${NGINX_RESOLVER} valid=10s;
    resolver_timeout 5s;
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    client_body_temp_path /tmp/nginx-body;
    proxy_temp_path /tmp/nginx-proxy;

    # Railway's edge sets X-Forwarded-Proto and X-Real-IP; keep the real client IP
    # for the Gateway's per-IP login lockout.
    map $http_x_forwarded_proto $forwarded_proto { default $scheme; "~*^https" https; }
    map $http_x_real_ip $client_ip { default $http_x_real_ip; "" $remote_addr; }
    map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

    server {
        listen ${PORT} default_server;
        ${LISTEN_V6}
        server_name _;
        set $gateway_upstream ${GATEWAY_UPSTREAM};
        set $frontend_upstream ${FRONTEND_UPSTREAM};
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # Railway health check: answers only when the Gateway answers too.
        location = /healthz {
            proxy_pass http://$gateway_upstream/health;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }
        location /api/langgraph/ {
            rewrite ^/api/langgraph/(.*) /api/$1 break;
            proxy_pass http://$gateway_upstream;
            proxy_set_header Connection '';
            proxy_set_header X-Accel-Buffering no;
            client_max_body_size 20M;
            proxy_request_buffering off;
            proxy_connect_timeout 600s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
            chunked_transfer_encoding on;
        }
        location = /api/skills/install/upload {
            proxy_pass http://$gateway_upstream;
            client_max_body_size 101M;
            proxy_request_buffering off;
            proxy_read_timeout 600s;
        }
        location ~ ^/api/threads/[^/]+/uploads {
            proxy_pass http://$gateway_upstream;
            client_max_body_size 100M;
            proxy_request_buffering off;
        }
        location ~ ^/api/projects/[^/]+/documents {
            proxy_pass http://$gateway_upstream;
            client_max_body_size 100M;
            proxy_request_buffering off;
            proxy_read_timeout 600s;
        }
        location ~ ^/api/threads/[^/]+/browser/stream {
            proxy_pass http://$gateway_upstream;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_connect_timeout 600s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
        }
        location /api/sandboxes { return 404; }
        location /api/ {
            proxy_pass http://$gateway_upstream;
            proxy_read_timeout 600s;
        }
        location = /health { proxy_pass http://$gateway_upstream; }
        location / {
            proxy_pass http://$frontend_upstream;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_connect_timeout 60s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
        }
    }
}
